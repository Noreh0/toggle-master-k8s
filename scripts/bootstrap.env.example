# Copie para scripts/bootstrap.env (ignorado pelo Git) e preencha. NUNCA commite o arquivo real.
# Valores com caracteres especiais ficam entre aspas simples.

# Senha do RDS (a mesma de infra/terraform.tfvars). Se vazia, o script tenta ler do tfvars.
DB_PASSWORD='troque-por-sua-senha'

# New Relic: "Ingest - License" key da conta US (OBRIGATÓRIA para os traces chegarem ao APM).
NEW_RELIC_LICENSE_KEY=''

# Alertas (usados nos contact points do Grafana)
PAGERDUTY_INTEGRATION_KEY=''   # Events API v2 integration key do serviço no PagerDuty
DISCORD_WEBHOOK_URL=''         # URL do webhook do canal do Discord
GITHUB_DISPATCH_TOKEN=''       # PAT fine-grained (só o repo toggle-master-k8s, Actions: Read and write)
