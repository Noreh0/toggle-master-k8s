diff --git a/infra/modules/ci-access/main.tf b/infra/modules/ci-access/main.tf
index 05da634..3901655 100644
--- a/infra/modules/ci-access/main.tf
+++ b/infra/modules/ci-access/main.tf
@@ -48,3 +48,46 @@ resource "aws_iam_user_policy_attachment" "ci_ecr_push" {
 # Se fizéssemos, o Secret Access Key ficaria salvo em texto no terraform.tfstate.
 # Gere a chave manualmente uma vez via CLI (ver README/RUNBOOK) e cole
 # direto nos Secrets do GitHub — sem passar pelo Terraform.
+
+# ---------- Auto-reparo (workflow self-heal.yaml) ----------
+# O mesmo usuário de CI roda `kubectl rollout restart` quando o alerta do Grafana dispara.
+# Duas peças: (1) IAM: só consegue descrever o cluster para montar o kubeconfig;
+# (2) EKS access entry: dentro do cluster, só edita recursos do namespace da aplicação
+# (política gerenciada AmazonEKSEditPolicy com escopo no namespace; sem acesso a outros namespaces).
+data "aws_iam_policy_document" "eks_describe" {
+  statement {
+    sid       = "DescribeClusterForKubeconfig"
+    actions   = ["eks:DescribeCluster"]
+    resources = [var.cluster_arn]
+  }
+}
+
+resource "aws_iam_policy" "eks_describe" {
+  name        = "${var.project_name}-ci-eks-describe"
+  description = "Permite ao usuário de CI gerar o kubeconfig do cluster (auto-reparo)"
+  policy      = data.aws_iam_policy_document.eks_describe.json
+}
+
+resource "aws_iam_user_policy_attachment" "ci_eks_describe" {
+  user       = aws_iam_user.ci.name
+  policy_arn = aws_iam_policy.eks_describe.arn
+}
+
+resource "aws_eks_access_entry" "ci" {
+  cluster_name  = var.cluster_name
+  principal_arn = aws_iam_user.ci.arn
+  type          = "STANDARD"
+}
+
+resource "aws_eks_access_policy_association" "ci_edit_app_namespace" {
+  cluster_name  = var.cluster_name
+  principal_arn = aws_iam_user.ci.arn
+  policy_arn    = "arn:aws:eks::aws:cluster-access-policy/AmazonEKSEditPolicy"
+
+  access_scope {
+    type       = "namespace"
+    namespaces = [var.app_namespace]
+  }
+
+  depends_on = [aws_eks_access_entry.ci]
+}
diff --git a/infra/modules/ci-access/variables.tf b/infra/modules/ci-access/variables.tf
index 58e8ab3..b003c35 100644
--- a/infra/modules/ci-access/variables.tf
+++ b/infra/modules/ci-access/variables.tf
@@ -6,3 +6,19 @@ variable "ecr_repository_arns" {
   description = "ARNs dos 5 repositórios ECR aos quais o usuário de CI pode dar push"
   type        = list(string)
 }
+
+variable "cluster_name" {
+  description = "Nome do cluster EKS onde o auto-reparo vai rodar `kubectl rollout restart`"
+  type        = string
+}
+
+variable "cluster_arn" {
+  description = "ARN do cluster EKS (permite eks:DescribeCluster para gerar o kubeconfig)"
+  type        = string
+}
+
+variable "app_namespace" {
+  description = "Namespace da aplicação: único lugar onde o usuário de CI tem permissão de edição no cluster"
+  type        = string
+  default     = "toggle-app"
+}
diff --git a/infra/modules/eks/main.tf b/infra/modules/eks/main.tf
index d0d09b1..42b2fbb 100644
--- a/infra/modules/eks/main.tf
+++ b/infra/modules/eks/main.tf
@@ -31,6 +31,13 @@ resource "aws_eks_cluster" "main" {
     endpoint_public_access  = true
   }
 
+  # Access entries (usadas pelo usuário de CI no auto-reparo) + aws-auth ConfigMap legado.
+  # O criador do cluster continua administrador.
+  access_config {
+    authentication_mode                         = "API_AND_CONFIG_MAP"
+    bootstrap_cluster_creator_admin_permissions = true
+  }
+
   depends_on = [aws_iam_role_policy_attachment.cluster_policy]
 }
 
