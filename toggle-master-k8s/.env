    AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_ACCESS_KEY_ID
    AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET_ACCESS_KEY
    # --- Configuração da AWS (Obrigatório para o desafio) ---
    # Cole a URL da fila SQS que você criou no console da AWS
    AWS_SQS_URL="REPLACE_WITH_SQS_URL"
    # Região da sua fila SQS
    AWS_REGION="us-east-1"